# Stripe (Test Mode) - Optional, will use Nuvei if configured
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Nuvei (Recommended for gaming/wagering)
NUVEI_MERCHANT_ID="..."
NUVEI_MERCHANT_SITE_ID="..."
