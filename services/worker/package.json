{
  "name": "worker",
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently \"pnpm:dev:main\" \"pnpm:dev:email\" \"pnpm:dev:bgcheck\"",
    "dev:main": "tsx watch src/index.ts",
    "dev:email": "tsx watch src/email-worker.ts",
    "dev:bgcheck": "tsx watch src/background-check-worker.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ignite/ledger": "workspace:*",
    "@ignite/shared": "workspace:*",
    "@prisma/client": "^5.14.0",
    "@sendgrid/mail": "^8.1.6",
    "bullmq": "^5.7.0",
    "concurrently": "^9.2.1",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
